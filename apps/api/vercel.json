{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,public/downloads/**,../../packages/db/dist/**}"
    }
  },
  "routes": [
    { "src": "/downloads/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
