# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fireslot?schema=public"

# Backend (apps/api)
JWT_SECRET="replace-with-strong-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
